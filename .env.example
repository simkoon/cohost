# CoHost 서버 설정 예시. 이 파일을 .env 로 복사해서 쓴다(.env 는 커밋하지 않는다).
#   cp .env.example .env
# .env 가 없어도 아래 기본값으로 뜬다. 실제 비밀번호나 회사·현장 정보는 이 파일에 쓰지 않는다.

# 서버 이미지 태그. 폐쇄망 반입(docker save/load) 때 같은 태그를 쓴다.
COHOST_VERSION=dev

# 호스트에 게시할 HTTPS 포트. API, WebSocket, 어드민 화면이 이 포트 하나로 나간다.
COHOST_PORT=8443

# 자체 서명 인증서의 SAN에 들어갈 서버 이름·IP(쉼표로 구분). localhost 는 항상 들어간다.
# 인증서는 최초 기동 때 한 번만 만들어지므로 첫 기동 전에 정한다. 예: cohost.local,192.0.2.10
COHOST_HOSTNAMES=cohost.local

# PostgreSQL 비밀번호. 비워 두면 기본값 cohost-change-me 가 쓰이고 서버가 경고를 띄운다.
# 운영에서는 긴 임의 값을 넣는다. 영문자, 숫자, 하이픈(-), 밑줄(_), 마침표(.)만 쓴다.
# 세미콜론, 따옴표, 달러 기호, 공백 같은 문자는 DB 연결 문자열이나 compose 변수 치환을 깨뜨린다.
# 생성 예: openssl rand -hex 32
# postgres 는 데이터 볼륨을 처음 만들 때만 이 값을 적용한다. 반드시 첫 기동 전에 정한다.
# 이미 기동한 뒤에 바꾸려면 .env 를 고치기 전에 DB 쪽 비밀번호를 먼저 바꾸고, 그다음 .env 를 고쳐
# docker compose up -d 로 다시 띄운다.
#   docker compose exec postgres psql -U cohost -d cohost -c "ALTER USER cohost PASSWORD '새 값'"
# 보존할 데이터가 없으면 docker compose down 후 docker volume rm cohost_cohost-pgdata 로 DB 볼륨만
# 지우고 다시 띄워도 된다. docker compose down -v 는 인증서·서명키 볼륨(cohost-data)까지 지워
# 인증서 지문이 바뀌므로 쓰지 않는다.
COHOST_DB_PASSWORD=
